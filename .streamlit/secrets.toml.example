# Modèle des secrets. Sur Streamlit Cloud : Settings → Secrets, colle ce contenu
# avec tes vraies valeurs. En local : copie ce fichier en .streamlit/secrets.toml
# (il est ignoré par git, il ne doit jamais être publié).

# Base Turso — sans ces deux lignes, l'app utilise un fichier SQLite local.
TURSO_DATABASE_URL = "libsql://poubelles-TON-COMPTE.turso.io"
TURSO_AUTH_TOKEN = "colle-ici-le-jeton-genere-par-turso"

# Code demandé à l'inscription (modifiable ensuite depuis la page Admin).
POUBELLES_CODE_INVITATION = "change-moi"

# Pseudo qui reçoit les droits admin à l'inscription.
POUBELLES_ADMIN = "andre"
